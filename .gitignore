# Credentials & tokens — NEVER commit these
client_secrets.json
client_secret_*.json
token.pickle
# Cached channel name written at connect time. Not a credential, but it names
# the owner's channel and the repo is public as of 2026-08-05.
.youtube_channel
# Flask session signing key. Not a password, but anyone holding it can forge a
# session cookie — which is enough to reach the YouTube upload routes.
.flask_secret

# Generated media & large files
downloads/
clips/
uploads/
*.mp4
*.m4a
*.wav
*.srt

# Database (contains user emails / tokens — never commit)
data.db
data.db-wal
data.db-shm

# Python
__pycache__/
*.pyc
.venv/
venv/

# graphify knowledge graph. The report is the shared, reviewable artifact and IS
# committed; graph.json/html, caches and dated backups are regenerated every 6h
# by project-dashboard/scripts/refresh.sh, so they stay out of history.
graphify-out/*
!graphify-out/GRAPH_REPORT.md
